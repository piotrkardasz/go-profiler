# Example .env file for go-profiler basic demo
APP_NAME=go-profiler-demo
APP_ENV=development
APP_DEBUG=true
APP_PORT=8080

# Request body capture (opt-in: captures POST/PUT/PATCH bodies in profiles)
PROFILER_CAPTURE_BODY=true

# Show full header values in profiles (disable redaction for local dev)
PROFILER_REDACT_HEADERS=false

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=profiler_demo
DB_USER=postgres
DB_PASSWORD=secret123

# Redis
REDIS_URL=redis://localhost:6379/0

# External APIs
API_KEY=sk-demo-1234567890
API_TIMEOUT=30s
